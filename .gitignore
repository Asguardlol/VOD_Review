# ---- Dependencies ----
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ---- Build output ----
dist/
dist-ssr/
build/
out/
*.tsbuildinfo

# ---- Secrets / environment ----
# This repo is public on GitHub Pages. Nothing here is needed to run the app
# (there is no backend and no API keys), but keep the net wide so a future
# Cloudflare/Supabase adapter can't leak credentials by accident.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets.json
credentials.json
.dev.vars
.netrc
.npmrc

# ---- Cloudflare (Workers / D1), if/when a backend is added ----
.wrangler/
wrangler.toml.local

# ---- Caches ----
.vite/
.cache/
.temp/
.tmp/
.eslintcache
.oxlintcache
*.local

# ---- Test / coverage ----
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/
# playwright-cli session state: snapshots, console logs, screenshots
.playwright-cli/

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- Claude Code local state ----
# settings.json is shared on purpose; the .local.json variants hold
# machine-specific paths and permission grants and must not be published.
.claude/settings.local.json
.claude/*.local.json
.claude/memory/

# ---- OS cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Planning / handoff docs ----
# Internal working docs stay local. They carry absolute Windows paths, pointers
# to the sibling raid-planner repo, and notes about how the maintainer likes to
# work — none of which belongs in a public repo. README.md is the public doc.
CLAUDE.md
AGENTS.md
HANDOFF.md
NOTES.md
TODO.md
PLAN.md
docs/planning/
*.plan.md
*.handoff.md

# ---- Project scratch ----
# Local-only working files. Exported reviews can contain guild names, raider
# names, and Discord handles — real people's details. Keep them out of the repo.
scratch/
tmp/
*.bak
exports/
*.review.json
