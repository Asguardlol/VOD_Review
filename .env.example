# Copy to .env for local overrides. .env itself is gitignored.

# Base path for built assets. Defaults to /WoW_VOD_Review/ (GitHub Pages project
# site). Set to / if you move to a custom domain, which serves from the root.
# VITE_BASE=/

# There are no API keys in this project. It is static-only: YouTube and Twitch
# are embedded via their public iframe APIs, and all data lives in IndexedDB.
# If a backend adapter is ever added, its URL goes here.
# VITE_API_BASE_URL=
